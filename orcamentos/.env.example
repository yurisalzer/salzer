# Copie para .env (NUNCA envie o .env para o GitHub).
# Neon: "Connection string" com pooling (-pooler no host) para a aplicação
DATABASE_URL="postgresql://usuario:senha@ep-exemplo-pooler.sa-east-1.aws.neon.tech/orcamentos?sslmode=require"
# Neon: conexão direta (sem -pooler) para migrações e importações longas
DIRECT_URL="postgresql://usuario:senha@ep-exemplo.sa-east-1.aws.neon.tech/orcamentos?sslmode=require"
# Banco usado pelos testes automatizados (PostgreSQL local ou um branch do Neon)
TEST_DATABASE_URL="postgresql://postgres@127.0.0.1:5432/orcamentos_teste"
# Diretório temporário para uploads (precisa de espaço para o maior arquivo enviado)
UPLOAD_TMP_DIR="/tmp/orcamentos-upload"
# Tamanho máximo de upload em MB
UPLOAD_MAX_MB="200"
# Limite do banco usado no painel de espaço (MB). Neon Free: 512
LIMITE_BANCO_MB="512"
# Primeiro administrador (criado automaticamente na 1ª inicialização se não houver usuários).
# Depois do primeiro acesso, troque a senha em "Minha conta" e APAGUE ADMIN_SENHA_INICIAL.
ADMIN_EMAIL=""
ADMIN_NOME=""
ADMIN_SENHA_INICIAL=""
